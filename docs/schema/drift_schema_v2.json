  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"level\" TEXT NOT NULL, \"goal\" TEXT NOT NULL, \"daily_minutes\" INTEGER NOT NULL, \"show_pinyin\" INTEGER NOT NULL CHECK (\"show_pinyin\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, CHECK (length(trim(name)) BETWEEN 1 AND 160), CHECK (level IN ('beginner', 'basics', 'experienced')), CHECK (goal IN ('everyday', 'travel', 'reading')), CHECK (daily_minutes IN (5, 10, 15, 20)));"
        }
      ]
    },
    {
      "name": "app_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_preferences\" (\"id\" INTEGER NOT NULL, \"selected_profile_id\" INTEGER NOT NULL REFERENCES profiles (id), PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "foundation_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"foundation_progress\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"step\" INTEGER NOT NULL, \"completed\" INTEGER NOT NULL CHECK (\"completed\" IN (0, 1)), PRIMARY KEY (\"profile_id\"), CHECK (step BETWEEN 0 AND 8));"
        }
      ]
    }
