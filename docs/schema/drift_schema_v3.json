  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"level\" TEXT NOT NULL, \"goal\" TEXT NOT NULL, \"daily_minutes\" INTEGER NOT NULL, \"show_pinyin\" INTEGER NOT NULL CHECK (\"show_pinyin\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, CHECK (length(trim(name)) BETWEEN 1 AND 160), CHECK (level IN ('beginner', 'basics', 'experienced')), CHECK (goal IN ('everyday', 'travel', 'reading')), CHECK (daily_minutes IN (5, 10, 15, 20)));"
        }
      ]
    },
    {
      "name": "app_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_preferences\" (\"id\" INTEGER NOT NULL, \"selected_profile_id\" INTEGER NOT NULL REFERENCES profiles (id), PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "foundation_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"foundation_progress\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"step\" INTEGER NOT NULL, \"completed\" INTEGER NOT NULL CHECK (\"completed\" IN (0, 1)), PRIMARY KEY (\"profile_id\"), CHECK (step BETWEEN 0 AND 8));"
        }
      ]
    },
    {
      "name": "vocabulary_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vocabulary_progress\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"word_id\" TEXT NOT NULL, \"stage\" TEXT NOT NULL, \"due_at_ms\" INTEGER NOT NULL, \"version\" INTEGER NOT NULL, \"successful_reviews\" INTEGER NOT NULL, PRIMARY KEY (\"profile_id\", \"word_id\"), CHECK (length(word_id) BETWEEN 1 AND 100), CHECK (stage IN ('learning', 'review', 'relearning')), CHECK (due_at_ms >= 0), CHECK (version > 0), CHECK (successful_reviews >= 0));"
        }
      ]
    },
    {
      "name": "vocabulary_attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vocabulary_attempts\" (\"event_id\" TEXT NOT NULL, \"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"word_id\" TEXT NOT NULL, \"pack_id\" TEXT NOT NULL, \"content_revision\" INTEGER NOT NULL, \"version_before\" INTEGER NOT NULL, \"is_review\" INTEGER NOT NULL CHECK (\"is_review\" IN (0, 1)), \"answers_json\" TEXT NOT NULL, \"questions_json\" TEXT NOT NULL, \"passed\" INTEGER NOT NULL CHECK (\"passed\" IN (0, 1)), \"answered_at_ms\" INTEGER NOT NULL, \"next_due_at_ms\" INTEGER NOT NULL, \"next_stage\" TEXT NOT NULL, PRIMARY KEY (\"event_id\"), CHECK (length(event_id) = 32), CHECK (content_revision > 0), CHECK (version_before >= 0), CHECK (answered_at_ms >= 0), CHECK (next_due_at_ms >= answered_at_ms), CHECK (next_stage IN ('learning', 'review', 'relearning')), UNIQUE (profile_id, word_id, version_before));"
        }
      ]
    }
  ]
